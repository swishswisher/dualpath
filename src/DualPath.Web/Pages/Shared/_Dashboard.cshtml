@model DualPath.Web.Pages.IndexModel
@{var next=Model.Courses.Where(Model.Available).SelectMany(c=>c.Lessons).FirstOrDefault(l=>l.Published&&!Model.Completed.Contains(l.Id));var ownWork=Model.Works.Where(w=>w.UserId==Model.Actor!.Id).ToList();}
<div class="dashboard-grid"><div><section class="welcome"><div><div class="eyebrow">Your next useful step</div><h2>@(next?.Title??"Look at what you’ve built.")</h2><p>@(next?.Objective??"Review your portfolio and choose a skill you’d like to practise next.")</p><a class="btn sky sm" href="@(next==null?"/work":"/lesson/"+next.Id)">@(next==null?"Open your work":"Continue learning") →</a></div><div class="progress-ring" style="--progress:@Model.Percentage" role="progressbar" aria-label="Learning progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.Percentage"><b>@Model.Percentage%</b><span>YOUR PATH SO FAR</span></div></section><div class="stat-grid"><div class="stat"><div class="label">Lessons completed</div><b>@Model.Completed.Count / @Model.LessonCount</b><small>From your saved learning records</small></div><div class="stat"><div class="label">Work samples</div><b>@ownWork.Count</b><small>Your saved drafts and submissions</small></div><div class="stat"><div class="label">Feedback received</div><b>@ownWork.Sum(w=>w.Reviews.Count)</b><small>Reviews from your instructor</small></div></div><div class="subhead"><h3>Your learning path</h3><a href="/learning">View full path →</a></div>@foreach(var c in Model.Courses.Where(c=>c.Published).Take(3)){<a class="learning-item" href="@(Model.Available(c)?"/lesson/"+c.Lessons.FirstOrDefault()?.Id:"/billing")"><span class="learning-number">@c.Position.ToString("00")</span><div><h4>@c.Title</h4><p>@c.Lessons.Count(l=>l.Published) lessons · @(Model.Available(c)?"Available":"Plan required")</p></div><div class="right"><span class="badge">@Model.CoursePercentage(c)%</span><div class="progress-track"><span style="width:@(Model.CoursePercentage(c))%"></span></div></div></a>}<section class="card" style="margin-top:22px"><h3>A moment to reflect</h3><p>What made it easier to follow through this week?</p><a class="text-link" href="/reflections">Write a short reflection →</a></section></div><aside><section class="card"><h3>Your direction</h3>@if(string.IsNullOrWhiteSpace(Model.Actor!.Goal)){<p>Choose a concrete goal to give your next steps a direction.</p><a class="btn outline sm" href="/onboarding">Set your starting goal →</a>}else{<p>@Model.Actor.Goal</p><a class="text-link" href="/onboarding">Review your goal →</a>}<div class="divider"></div><h4>Your cohorts</h4>@if(Model.Cohorts.Count==0){<p>You haven’t joined a cohort yet. You can learn independently or accept an institution invitation.</p>}@foreach(var c in Model.Cohorts){<a class="schedule-item" href="/cohort/@c.Id"><span class="avatar sky">@c.Name[0]</span><div><h4>@c.Name</h4><p>@c.Instructor.DisplayName</p></div></a>}</section><section class="feedback-card"><div class="eyebrow">A fresh perspective</div>@{var feedback=ownWork.SelectMany(w=>w.Reviews).OrderByDescending(r=>r.CreatedAt).FirstOrDefault();}@if(feedback==null){<p>Your instructor’s feedback will appear here after your first review.</p><a class="text-link" href="/work">Explore practical work →</a>}else{<p>@(feedback.Feedback.Length>200?feedback.Feedback[..200]+"…":feedback.Feedback)</p><a class="text-link" href="/feedback/@feedback.SubmissionId">Read the full feedback →</a>}</section></aside></div>
