@model DualPath.Web.Pages.IndexModel
<div class="wrap"><section class="card auth-card"><div class="eyebrow">Your next chapter starts here</div><h1>@Model.Title</h1>
@if(Model.Section=="signin"){
<p class="muted">Your work, your progress, your next step.</p><form method="post"><input type="hidden" name="Command" value="login"><input type="hidden" name="Input.ReturnUrl" value="@Context.Request.Query["ReturnUrl"]"><div class="field"><label asp-for="Input.Email">Email address</label><input asp-for="Input.Email" type="email" autocomplete="username" required></div><div class="field"><label asp-for="Input.Password">Password</label><input asp-for="Input.Password" type="password" autocomplete="current-password" required></div><div class="between"><label class="label-check"><input asp-for="Input.Remember">Remember this device</label><a class="text-link" href="/reset">Forgot password?</a></div><button class="btn full" style="margin-top:23px">Sign in →</button></form><p class="form-note" style="margin-top:20px">New here? <a class="text-link" href="/signup">Create an account</a></p><details style="margin-top:20px"><summary>Resend a verification email</summary><form method="post" style="margin-top:18px"><input type="hidden" name="Command" value="resend"><div class="field"><label for="resend-email">Email address</label><input id="resend-email" name="Input.Email" type="email" autocomplete="email" required></div><button class="btn outline full">Send a new confirmation link</button></form></details>
}else if(Model.Section=="signup"){
<p class="muted">Start with a free foundations module, then choose the support you need.</p><form method="post"><input type="hidden" name="Command" value="register"><div class="field"><label asp-for="Input.Name">Your name</label><input asp-for="Input.Name" autocomplete="name" maxlength="120" required></div><div class="field"><label asp-for="Input.Email">Email address</label><input asp-for="Input.Email" type="email" autocomplete="email" required></div><div class="field"><label asp-for="Input.Password">Password</label><input asp-for="Input.Password" type="password" minlength="12" autocomplete="new-password" required><span class="hint">At least 12 characters, with uppercase/lowercase letters, a number, and a symbol.</span></div><label class="label-check"><input asp-for="Input.Agree" required><span>I agree to the <a class="text-link" href="/terms">service terms</a> and have read the <a class="text-link" href="/privacy">privacy notice</a>.</span></label><button class="btn full" style="margin-top:23px">Create your account →</button><p class="form-note" style="margin-top:15px">Verify your email before signing in. We won’t enrol you in a paid plan automatically.</p></form>
}else if(Model.Section=="reset"){
<p class="muted">If a verified account exists, we’ll queue recovery instructions for that address.</p><form method="post"><input type="hidden" name="Command" value="reset"><div class="field"><label asp-for="Input.Email">Email address</label><input asp-for="Input.Email" type="email" autocomplete="email" required></div><button class="btn full">Request reset instructions →</button></form>
}else if(Model.Section=="reset-password"){
<form method="post"><input type="hidden" name="Command" value="reset-password"><input type="hidden" name="Input.Email" value="@Context.Request.Query["email"]"><input type="hidden" name="Input.Code" value="@Context.Request.Query["code"]"><div class="field"><label asp-for="Input.Password">New password</label><input asp-for="Input.Password" type="password" minlength="12" autocomplete="new-password" required></div><button class="btn full">Update password →</button></form>
}
</section></div>
