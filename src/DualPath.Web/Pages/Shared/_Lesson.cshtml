@model DualPath.Web.Pages.IndexModel
@{var lesson=Model.Lesson!;var course=Model.Courses.Single(c=>c.Id==lesson.CourseId);var options=JsonSerializer.Deserialize<string[]>(lesson.OptionsJson)!;}
<div class="lesson-grid"><div><section class="lesson-cover"><div class="eyebrow">@course.Title / Lesson @lesson.Position</div><h2>@lesson.Title</h2><p>@lesson.Objective</p></section><article class="card"><div class="prose">@lesson.Body</div><div class="divider"></div><h3>Try a knowledge check.</h3><p>@lesson.Question</p>@if(Model.Completed.Contains(lesson.Id)){<div class="notice">This lesson is completed in your learning record. You can practise the question again.</div>}<form method="post"><input type="hidden" name="Command" value="complete"><input type="hidden" name="Input.Id" value="@lesson.Id">@for(var i=0;i<options.Length;i++){<label class="choice"><input type="radio" name="Input.Answer" value="@i" required><span>@options[i]</span></label>}<button class="btn" style="margin-top:22px">Check answer & save progress →</button></form></article></div><aside><section class="card"><div class="mini-label">Your module</div><h3>@course.Title</h3>@foreach(var l in course.Lessons.Where(l=>l.Published)){<a class="lesson-step @(l.Id==lesson.Id?"active":"")" href="/lesson/@l.Id"><span class="step-dot">@(Model.Completed.Contains(l.Id)?"✓":l.Position.ToString())</span>@l.Title</a>}<div class="divider"></div>@{var assignment=Model.Assignments.FirstOrDefault(a=>a.CourseId==course.Id);}@if(assignment!=null){<a class="btn outline full sm" href="/assignment/@assignment.Id">Try the practical assignment →</a>}<a class="text-link" href="/learning" style="margin-top:18px">← Your full path</a></section></aside></div>
