@model DualPath.Web.Pages.IndexModel
@if(Model.Section=="review"&&Model.Work is {} work){
<div class="split-panel"><section class="card"><div class="mini-label">Revision @work.Revision · @work.Status</div><h2 style="font-size:30px">@work.Title</h2><p class="subtitle">@work.User.DisplayName · @work.Assignment.Title</p><div class="read-work">@work.Body</div><div class="divider"></div>@foreach(var f in work.Files){<a class="file-row" href="/files/@f.Id">↓ @f.OriginalName</a>}<a class="text-link" href="/reviews">← Return to review queue</a></section><form method="post" class="card"><input type="hidden" name="Command" value="review"><input type="hidden" name="Input.Id" value="@work.Id"><input type="hidden" name="Input.Revision" value="@work.Revision"><h3>Give one useful next step.</h3><div class="form-grid"><div class="field"><label asp-for="Input.Research">Research & relevance</label><select asp-for="Input.Research">@for(var i=1;i<=4;i++){<option value="@i">@i / 4</option>}</select></div><div class="field"><label asp-for="Input.Clarity">Clarity</label><select asp-for="Input.Clarity">@for(var i=1;i<=4;i++){<option value="@i">@i / 4</option>}</select></div><div class="field"><label asp-for="Input.Tone">Presentation & tone</label><select asp-for="Input.Tone">@for(var i=1;i<=4;i++){<option value="@i">@i / 4</option>}</select></div></div><div class="field"><label asp-for="Input.Body">Your feedback</label><textarea asp-for="Input.Body" minlength="10" maxlength="10000" required></textarea></div><div class="field"><label asp-for="Input.Decision">Review decision</label><select asp-for="Input.Decision"><option>Approved</option><option>Revision requested</option></select></div><button class="btn full" disabled="@(work.Status!="Submitted")">Publish feedback →</button><p class="form-note" style="margin-top:15px">Feedback is saved against this submitted revision and shared with the learner.</p></form></div>
}else{
var queue=Model.Works.Where(w=>w.Status=="Submitted"&&w.UserId!=Model.Actor!.Id).ToList();<div class="stat-grid"><div class="stat"><div class="label">Your visible cohorts</div><b>@Model.Cohorts.Count</b></div><div class="stat"><div class="label">Awaiting your feedback</div><b>@queue.Count</b></div><div class="stat"><div class="label">Enrolled learners</div><b>@Model.Cohorts.SelectMany(c=>c.Enrolments).Select(e=>e.UserId).Distinct().Count()</b></div></div><section class="card"><div class="subhead"><h3>Work ready for your perspective</h3><a class="text-link" href="/courses">Learning content →</a></div>@if(queue.Count==0){<div class="empty-state"><h3>Your review queue is clear.</h3><p>New submissions from your assigned cohorts will appear here.</p><a class="btn outline sm" href="/cohorts">Open your cohorts</a></div>}else{<div class="table-wrap"><table class="table"><thead><tr><th>Learner</th><th>Work</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var w in queue){<tr><td>@w.User.DisplayName</td><td>@w.Title<div class="tiny muted">Revision @w.Revision</div></td><td><span class="badge orange">@w.Status</span></td><td><a class="btn outline sm" href="/review/@w.Id">Review →</a></td></tr>}</tbody></table></div>}</section>
}
