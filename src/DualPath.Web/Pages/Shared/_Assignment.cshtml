@model DualPath.Web.Pages.IndexModel
@{var own=Model.Works.Where(w=>w.UserId==Model.Actor!.Id).ToList();var assignment=Model.Assignments.FirstOrDefault(a=>a.Id==Model.Input.Id);}
@if(Model.Section=="work"){
<div class="subhead"><h3>Your growing proof portfolio</h3><a class="btn outline sm" href="/learning">Explore your learning path →</a></div><div class="grid2">@foreach(var a in Model.Assignments){var work=own.FirstOrDefault(w=>w.AssignmentId==a.Id);<article class="card"><div class="between"><span class="mini-label">@a.Course.Title</span><span class="badge @(work?.Status=="Draft"?"orange":"")">@(work?.Status??"Not started")</span></div><h3 style="margin-top:20px">@a.Title</h3><p>@a.Instructions</p><a class="btn outline sm" href="/assignment/@a.Id">@(work==null?"Start your work":"Open your work") →</a></article>}</div>
}else if(assignment!=null){
<div class="split-panel"><section class="card"><div class="mini-label">@assignment.Course.Title</div><h2 style="font-size:30px">@assignment.Title</h2><p class="prose">@assignment.Instructions</p><div class="callout">Include your own reasoning and one useful next improvement. Do not upload private third-party information.</div><h4>How the work is reviewed</h4><div class="line-item"><span>Research & relevance</span><span>1–4 points</span></div><div class="line-item"><span>Clarity of the ask or explanation</span><span>1–4 points</span></div><div class="line-item"><span>Specific, respectful presentation</span><span>1–4 points</span></div><div class="divider"></div><a class="text-link" href="/work">← All your work</a></section><section class="card">
@if(Model.Work is {Status:"Submitted" or "Approved"}){<div class="completion-box"><h3>@(Model.Work.Status=="Approved"?"Your work has been reviewed.":"Your work is ready for review.")</h3><p>@Model.Work.Title</p><span class="badge">@Model.Work.Status</span></div><div class="divider"></div><div class="read-work">@Model.Work.Body</div><div style="margin-top:20px"><a class="btn outline sm" href="/feedback/@Model.Work.Id">View feedback & revision history →</a></div>}
else{
@if(Model.Work?.Status=="Revision requested"){<div class="notice orange">Your instructor requested a revision. Read the feedback, then save or submit your next attempt.</div>}
<form method="post"><input type="hidden" name="Command" value="submission"><input type="hidden" name="Input.Id" value="@assignment.Id"><input type="hidden" name="Input.Version" value="@(Model.Work?.Version??0)"><div class="field"><label for="work-title">Brief title</label><input id="work-title" name="Input.Title" value="@Model.Work?.Title" maxlength="200" required></div><div class="field"><label for="work-body">Your notes & work</label><textarea id="work-body" name="Input.Body" maxlength="20000" rows="10" required>@Model.Work?.Body</textarea></div><div class="field"><label asp-for="Input.CohortId">Share with your assigned cohort instructor</label><select name="Input.CohortId" id="Input_CohortId"><option value="">Independent work · no instructor assignment</option>@foreach(var c in Model.Cohorts.Where(c=>c.CourseId==assignment.CourseId&&c.Enrolments.Any(e=>e.UserId==Model.Actor!.Id))){<option value="@c.Id" selected="@(Model.Work?.CohortId==c.Id)">@c.Name</option>}</select><span class="hint">Only an assigned instructor can review cohort submissions.</span></div><div class="actions"><button class="btn outline" name="Input.Publish" value="false">Save draft</button><button class="btn" name="Input.Publish" value="true">Submit for review →</button></div></form>
}
@if(Model.Work!=null){<div class="divider"></div><h4>Private attachments</h4>@foreach(var f in Model.Work.Files){<a class="file-row" href="/files/@f.Id">↓ @f.OriginalName <span class="muted">@(f.Length/1024) KB</span></a>}@if(Model.Work.Status=="Draft"){<form method="post" enctype="multipart/form-data"><input type="hidden" name="Command" value="upload"><input type="hidden" name="Input.Id" value="@Model.Work.Id"><div class="field"><label asp-for="Input.File">Add a PDF or DOCX</label><input asp-for="Input.File" type="file" accept=".pdf,.docx" required><span class="hint">Maximum 10 MB. Files are private and downloaded as attachments.</span></div><button class="btn outline sm">Save private attachment</button></form>}}
</section></div>
}
