@model DualPath.Web.Pages.IndexModel
<div class="stat-grid"><div class="stat"><div class="label">Learning completion</div><b>@Model.Percentage%</b><small>Published lessons completed</small></div><div class="stat"><div class="label">Completed lessons</div><b>@Model.Completed.Count / @Model.LessonCount</b><small>Saved completion records</small></div><div class="stat"><div class="label">Reviewed work</div><b>@Model.Works.Count(w=>w.UserId==Model.Actor!.Id&&w.Reviews.Count>0)</b><small>Human-reviewed submissions</small></div></div><section class="card"><h3>The work behind your progress</h3>@foreach(var c in Model.Courses.Where(c=>c.Published)){<div class="status-row"><div class="between"><h4>@c.Title</h4><span class="tiny">@Model.CoursePercentage(c)%</span></div><div class="progress-track"><span style="width:@(Model.CoursePercentage(c))%"></span></div></div>}<p class="form-note" style="margin-top:20px">Completion describes your recorded learning activity, not a validated measure of employability.</p></section><section class="card" style="margin-top:22px"><h3>Recent knowledge checks</h3>@if(Model.Attempts.Count==0){<p>No assessment attempts yet.</p>}@foreach(var a in Model.Attempts.Take(10)){<div class="line-item"><span>@a.Lesson.Title</span><span class="badge @(a.Correct?"":"orange")">@(a.Correct?"Correct":"Try again")</span></div>}</section>
