@model DualPath.Web.Pages.IndexModel
@{var selected=Model.Work;var reviewed=Model.Works.Where(w=>w.UserId==Model.Actor!.Id&&w.Reviews.Count>0).ToList();}
@if(selected==null){<section class="card"><h3>A fresh perspective, when it’s ready.</h3>@if(reviewed.Count==0){<p>Your instructor feedback will appear after a submission is reviewed.</p><a class="btn outline sm" href="/work">Explore your practical work →</a>}@foreach(var w in reviewed){<a class="notification" href="/feedback/@w.Id"><div><h4>@w.Title</h4><p>@w.Status · @w.Reviews.Count review(s)</p></div></a>}</section>}
else{
<section class="card"><div class="between"><h2 style="font-size:30px">@selected.Title</h2><span class="badge">@selected.Status</span></div>@if(selected.Reviews.Count==0){<p>No feedback has been published yet. Your work remains saved in the review queue.</p>}@foreach(var r in selected.Reviews.OrderByDescending(r=>r.CreatedAt)){<article class="status-row"><div class="mini-label">Revision @r.Revision · @r.CreatedAt.ToString("dd MMM yyyy")</div><h3>@r.Decision</h3><p class="read-work">@r.Feedback</p><div class="line-item"><span>Research @r.Research/4 · Clarity @r.Clarity/4 · Presentation @r.Tone/4</span></div></article>}<div class="actions" style="margin-top:22px"><a class="btn" href="/assignment/@selected.AssignmentId">Open your work →</a><a class="text-link" href="/reflections">Reflect on the feedback</a></div></section>
}
