@model DualPath.Web.Pages.IndexModel
<div class="grid2"><section class="card"><div class="eyebrow">A little space to think</div><h3>What helped you follow through?</h3><p>Describe one action, what happened, and one thing you’d try next.</p><form method="post"><input type="hidden" name="Command" value="reflection"><div class="field"><label asp-for="Input.Body">Your reflection</label><textarea asp-for="Input.Body" maxlength="8000" minlength="5" required></textarea></div><div class="field"><label asp-for="Input.CohortId">Visibility</label><select asp-for="Input.CohortId"><option value="">Only me</option>@foreach(var c in Model.Cohorts.Where(c=>c.Enrolments.Any(e=>e.UserId==Model.Actor!.Id))){<option value="@c.Id">Me and my assigned instructor · @c.Name</option>}</select></div><p class="form-note">Reflections are not included in AI practice requests.</p><button class="btn">Save your reflection →</button></form></section><section><h3>Your recent reflections</h3>@if(Model.Reflections.Count==0){<div class="empty-state"><h3>A useful moment, worth noticing.</h3><p>Your first reflection will appear here after you save it.</p></div>}@foreach(var r in Model.Reflections){<article class="card" style="margin-top:16px"><div class="mini-label">@r.CreatedAt.ToString("dd MMM yyyy") · @(r.CohortId==null?"Only you":"Assigned instructor can view")</div><p class="read-work">@r.Body</p></article>}</section></div>
