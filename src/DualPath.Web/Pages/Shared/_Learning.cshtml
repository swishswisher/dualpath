@model DualPath.Web.Pages.IndexModel
@if(Model.Section=="courses"){
<details class="card" style="margin-bottom:22px"><summary><strong>Create a course in your institution</strong></summary><form method="post" style="margin-top:22px"><input type="hidden" name="Command" value="course"><div class="field"><label asp-for="Input.OrganisationId">Institution</label><select asp-for="Input.OrganisationId">@if(Model.Actor!.PlatformAdmin){<option value="@Guid.Empty">Global curriculum</option>}@foreach(var org in Model.Cohorts.Select(c=>c.Organisation).Concat(Model.Organisations).DistinctBy(o=>o.Id)){<option value="@org.Id">@org.Name</option>}</select></div><div class="field"><label asp-for="Input.Title">Course title</label><input asp-for="Input.Title" maxlength="160" required></div><div class="field"><label asp-for="Input.Body">Summary</label><textarea asp-for="Input.Body" maxlength="2000" required></textarea></div><button class="btn">Create draft course →</button></form></details>
}
<div class="grid2">@foreach(var c in Model.Courses){<article class="card"><div class="card-top"><span class="learning-number">@c.Position.ToString("00")</span><span class="badge @(c.Published?"":"orange")">@(c.Published?"Published":"Draft")</span></div><h3>@c.Title</h3><p>@c.Summary</p><div class="progress-track"><span style="width:@(Model.CoursePercentage(c))%"></span></div><div class="between tiny muted" style="margin:10px 0 20px"><span>@c.Lessons.Count lessons</span><span>@Model.CoursePercentage(c)% completed</span></div>@if(Model.Section=="courses"&&(Model.Actor!.PlatformAdmin||c.OrganisationId!=null)){<div class="actions"><a class="btn outline sm" href="/author/@c.Lessons.FirstOrDefault()?.Id">Edit lesson →</a><a class="text-link" href="/lesson/@c.Lessons.FirstOrDefault()?.Id">Learner view</a></div>}else if(Model.Available(c)){<a class="btn outline sm" href="/lesson/@c.Lessons.FirstOrDefault()?.Id">Open module →</a>}else{<a class="btn outline sm" href="/billing">Choose a learning plan →</a>}</article>}</div>
