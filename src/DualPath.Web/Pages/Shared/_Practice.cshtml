@model DualPath.Web.Pages.IndexModel
<div class="split-panel"><section class="card"><div class="eyebrow">Evidence-based practice</div><h3>Make the next attempt clearer.</h3><p>Choose one of your assessments and practise a short answer. AI feedback is a writing suggestion, not a grade or hiring prediction.</p>@if(!Model.Actor!.AiConsent){<div class="notice orange">AI practice is optional and currently disabled for your account. Review the data-use choice in account settings before enabling it.</div><a class="btn outline" href="/account">Review AI preferences →</a>}else if(Model.Attempts.Count==0){<div class="notice">Complete a knowledge check first, so practice has a clear source.</div><a class="btn" href="/learning">Explore your learning path →</a>}else{<form method="post"><input type="hidden" name="Command" value="practice"><div class="field"><label asp-for="Input.AttemptId">Assessment to practise</label><select asp-for="Input.AttemptId">@foreach(var a in Model.Attempts.DistinctBy(a=>a.LessonId)){<option value="@a.Id">@a.Lesson.Question</option>}</select></div><div class="field"><label asp-for="Input.Body">Your practice answer</label><textarea asp-for="Input.Body" minlength="10" maxlength="5000" required></textarea></div><p class="form-note">This sends the selected question and this answer to the configured AI provider. Your account profile and reflections are excluded. A daily allowance limits usage.</p><button class="btn">Request practice feedback →</button></form>}</section><section><h3>Your saved practice</h3>@if(Model.Practices.Count==0){<div class="empty-state"><p>Completed practice feedback will appear here. If the AI provider is unavailable, you’ll see a clear error and no invented response.</p></div>}@foreach(var p in Model.Practices){<article class="card" style="margin-top:16px"><div class="mini-label">@p.CreatedAt.ToString("dd MMM yyyy") · AI-generated suggestion</div><h4>Your answer</h4><p class="read-work">@p.Answer</p><h4>Practice feedback</h4><p class="read-work">@p.Feedback</p></article>}</section></div>
