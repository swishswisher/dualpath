@model DualPath.Web.Pages.IndexModel
<form method="post" style="margin-bottom:22px"><input type="hidden" name="Command" value="report-export"><button class="btn outline sm">Download cohort CSV</button></form>
<section class="card"><h3>A useful view of learning.</h3><p>Progress and assessment counts for active learners in cohorts you manage. Private reflections and submission text are excluded.</p><div class="table-wrap"><table class="table"><thead><tr><th>Cohort / learner</th><th>Lessons completed</th><th>Correct attempts</th><th>Assignments submitted</th><th>Approved</th></tr></thead><tbody>@foreach(var r in Model.ReportRows){<tr><td><strong>@r.Learner</strong><div class="tiny muted">@r.Cohort</div></td><td>@r.Completed / @r.Lessons</td><td>@r.CorrectAttempts / @r.Attempts</td><td>@r.Submitted</td><td>@r.Approved</td></tr>}</tbody></table></div>@if(Model.ReportRows.Count==0){<p>No active learners are available to report on yet.</p>}<p class="form-note">Up to 5,000 enrolments per export.</p></section>
