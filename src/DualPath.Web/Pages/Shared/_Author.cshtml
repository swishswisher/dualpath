@model DualPath.Web.Pages.IndexModel
@{var l=Model.Lesson!;var edit=l.DraftJson!=""?JsonSerializer.Deserialize<LessonDraftData>(l.DraftJson)!:new LessonDraftData(l.Title,l.Objective,l.Body,l.Question,JsonSerializer.Deserialize<string[]>(l.OptionsJson)??new[]{"","",""},l.CorrectOption);var choices=edit.Options;}
<div class="body-grid"><form class="card" method="post"><input type="hidden" name="Command" value="lesson"><input type="hidden" name="Input.Id" value="@l.Id"><input type="hidden" name="Input.Version" value="@l.Version"><div class="between"><h3>A useful lesson starts with a clear goal.</h3><span class="badge">Version @l.ContentVersion</span></div><div class="field"><label for="lesson-title">Lesson title</label><input id="lesson-title" name="Input.Title" value="@edit.Title" maxlength="200" required></div><div class="field"><label for="lesson-objective">Learning objective</label><textarea id="lesson-objective" name="Input.Objective" maxlength="1000" required>@edit.Objective</textarea></div><div class="field"><label for="lesson-body">Lesson body</label><textarea id="lesson-body" name="Input.Body" maxlength="30000" minlength="30" rows="12" required>@edit.Body</textarea><span class="hint">Plain text is displayed safely. Use clear paragraphs and practical examples.</span></div><div class="field"><label for="quiz-question">Knowledge-check question</label><input id="quiz-question" name="Input.Question" value="@edit.Question" maxlength="1000" required></div>@for(var i=0;i<3;i++){<div class="field"><label for="option-@i">Answer choice @(i+1)</label><input id="option-@i" name="Input.Option@(i)" value="@choices.ElementAtOrDefault(i)" maxlength="1000" required></div>}<div class="field"><label for="correct-answer">Correct answer</label><select name="Input.Answer" id="correct-answer">@for(var i=0;i<3;i++){<option value="@i" selected="@(i==edit.Answer)">Choice @(i+1)</option>}</select></div><div class="actions"><button class="btn outline" name="Input.Publish" value="false">Save draft changes</button><button class="btn" name="Input.Publish" value="true">Publish lesson version →</button></div></form><aside class="card"><h3>Keep the learning traceable.</h3><p>Publishing creates an immutable lesson snapshot. A learner’s completion and assessment attempts retain the version they used.</p><div class="notice orange">Draft changes remain private until you publish a new lesson version. Global curriculum editing is limited to platform administrators.</div><a class="text-link" href="/lesson/@l.Id">Learner view →</a><div class="divider"></div><h4>Lessons in this course</h4>@foreach(var lesson in Model.Courses.First(c=>c.Id==l.CourseId).Lessons){<a class="lesson-nav-item" href="/author/@lesson.Id">@lesson.Position. @lesson.Title <small>@(lesson.Published?"Published":"Draft")</small></a>}<form method="post" style="margin-top:20px"><input type="hidden" name="Command" value="add-lesson"><input type="hidden" name="Input.CourseId" value="@l.CourseId"><div class="field"><label for="new-lesson-title">Add a lesson</label><input id="new-lesson-title" name="Input.Title" maxlength="200" required placeholder="A focused learning objective"></div><button class="btn outline full sm">Create lesson draft →</button></form></aside></div>
