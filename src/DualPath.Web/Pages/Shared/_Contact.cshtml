@model DualPath.Web.Pages.IndexModel
<div class="wrap"><div class="page-intro"><div class="eyebrow">A conversation is a good start</div><h1>Tell us what<br><span class="serif">you’re working toward.</span></h1><p class="lead">Planning a cohort, exploring student support, or have a question? Let’s find the right next step.</p></div><div class="grid2"><div><h3>We’ll start with your context.</h3><p class="muted">Share your goals, approximate student numbers, and the kind of support you have in mind. You don’t need a finished plan.</p><a class="text-link" href="/schools">Explore institutional programmes →</a></div><form class="card" method="post"><input type="hidden" name="Command" value="contact"><div class="form-grid"><div class="field"><label asp-for="Input.Name">Your name</label><input asp-for="Input.Name" maxlength="160" required></div><div class="field"><label asp-for="Input.Email">Email address</label><input asp-for="Input.Email" type="email" required></div></div><div class="field"><label asp-for="Input.Title">What would you like to discuss?</label><input asp-for="Input.Title" maxlength="200" required></div><div class="field"><label asp-for="Input.Body">Your message</label><textarea asp-for="Input.Body" minlength="10" maxlength="10000" required></textarea></div><label class="label-check"><input asp-for="Input.Agree" required>I have read the privacy notice and understand my enquiry will be saved for staff to review.</label><button class="btn full" style="margin-top:20px">Send your enquiry →</button></form></div></div>
