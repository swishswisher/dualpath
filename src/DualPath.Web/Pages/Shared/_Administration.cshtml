@model DualPath.Web.Pages.IndexModel
@if(Model.Section=="admin"){
<div class="grid3"><a class="card" href="/content"><h3>Public content</h3><p>Review and publish accurate programme resources.</p><span class="text-link">Open editorial workspace →</span></a><a class="card" href="/support"><h3>Service support</h3><p>Handle saved enquiries, access and privacy requests.</p><span class="text-link">Review support requests →</span></a><a class="card" href="/audit"><h3>Audited operations</h3><p>Trace permissioned changes without logging private content.</p><span class="text-link">Open activity records →</span></a></div><section class="card" style="margin-top:22px"><h3>Before commercial launch</h3><p>Verify payment, email and AI provider configuration; complete operator-specific policies; verify backups and a restore drill; and deploy the .NET application on a compatible host.</p>@if(Model.IsDemo){<a class="btn outline sm" href="/mailbox">Development email outbox →</a>}</section>
@if(Model.Emails.Count>0){<section class="card" style="margin-top:22px"><h3>Email delivery needs attention</h3>@foreach(var email in Model.Emails){<div class="line-item"><div><strong>@email.Subject</strong><p class="tiny muted">@email.Id · @email.Attempts attempts</p></div><form method="post"><input type="hidden" name="Command" value="retry-email"><input type="hidden" name="Input.Id" value="@email.Id"><button class="btn outline sm">Retry delivery</button></form></div>}</section>}
}else if(Model.Section=="content"){
<details class="card" style="margin-bottom:24px"><summary>Create a resource</summary><form method="post" style="margin-top:20px"><input type="hidden" name="Command" value="content-create"><div class="field"><label asp-for="Input.Title">Resource title</label><input asp-for="Input.Title" maxlength="200" required></div><div class="field"><label asp-for="Input.Body">Content</label><textarea asp-for="Input.Body" maxlength="30000" minlength="20" required></textarea></div><button class="btn">Create draft resource</button></form></details><div class="stack">@foreach(var p in Model.PublicContent){<form method="post" class="card"><input type="hidden" name="Command" value="content"><input type="hidden" name="Input.Id" value="@p.Id"><input type="hidden" name="Input.Version" value="@p.Version"><div class="between"><h3>@p.Title</h3><span class="badge">@(p.PublishedAt==null?"Draft":"Published")</span></div><div class="field"><label for="content-title-@p.Id">Page title</label><input name="Input.Title" id="content-title-@p.Id" value="@(p.DraftTitle==""?p.Title:p.DraftTitle)" maxlength="200" required></div><div class="field"><label for="content-body-@p.Id">Content</label><textarea name="Input.Body" id="content-body-@p.Id" maxlength="30000" minlength="20" required>@p.DraftBody</textarea></div><div class="actions"><button class="btn outline sm" name="Input.Publish" value="false">Save draft</button><button class="btn sm" name="Input.Publish" value="true">Publish content</button><a class="text-link" href="/article/@p.Slug">Public view →</a></div></form>}</div>
}else if(Model.Section=="audit"){
<section class="card table-wrap"><table class="table"><thead><tr><th>When (UTC)</th><th>Action</th><th>Actor ID</th><th>Target</th></tr></thead><tbody>@foreach(var a in Model.Audit){<tr><td>@a.CreatedAt.ToString("dd MMM HH:mm")</td><td>@a.Action</td><td class="tiny mono">@a.ActorUserId</td><td class="tiny mono">@a.Target</td></tr>}</tbody></table></section>
}else{
<div class="notice orange">Development-only mailbox. These messages have been queued, not necessarily delivered. Production has no mailbox view.</div>@foreach(var e in Model.Emails){<article class="card" style="margin-top:15px"><span class="badge">@e.Status · attempts @e.Attempts</span><h3 style="margin-top:15px">@e.Subject</h3><p>@e.ToEmail</p><p class="read-work">@e.Body</p></article>}
}
