@model DualPath.Web.Pages.IndexModel
@{var institution=Model.Section=="orgbilling";var subscriptions=Model.Subscriptions.Where(s=>institution?s.OrganisationId!=null:s.UserId==Model.Actor!.Id&&s.OrganisationId==null).ToList();}
@if(!Model.BillingReady){<div class="notice orange">Secure billing is not configured yet. No card details are collected here. Your saved work and free foundations remain available.</div>}
<div class="grid2"><section class="card"><h3>@(institution?"Your institution plans":"Your current plan")</h3>@if(subscriptions.Count==0){<p>You have no paid subscription. Foundations are available without a purchase.</p>}@foreach(var s in subscriptions){<div class="status-row"><div class="between"><h4>@s.Plan</h4><span class="badge">@s.Status</span></div>@if(s.DevelopmentOnly){<p class="tiny muted">Development entitlement only · no payment occurred.</p>}<p class="tiny muted">Paid-through date: @(s.PaidThrough?.ToString("dd MMM yyyy")??"Awaiting provider confirmation")</p>@if(s.CancelAtPeriodEnd){<p>Cancellation is scheduled at the end of the paid period.</p>}@if(s.CustomerId!=""&&!s.DevelopmentOnly){<form method="post"><input type="hidden" name="Command" value="portal"><input type="hidden" name="Input.OrganisationId" value="@s.OrganisationId"><button class="btn outline sm">Manage subscription, invoices & cancellation →</button></form>}</div>}<p class="form-note" style="margin-top:20px">Returning from checkout does not grant access by itself. Your plan activates only after a verified provider event.</p></section><section class="card"><h3>Choose your next level of support.</h3><form method="post"><input type="hidden" name="Command" value="checkout"><div class="field"><label asp-for="Input.Plan">Plan</label><select asp-for="Input.Plan">@if(!institution){<option>Independent</option><option>Guided</option>}else{<option>Institution</option>}</select></div>@if(institution){<div class="field"><label asp-for="Input.OrganisationId">Institution</label><select asp-for="Input.OrganisationId">@foreach(var o in Model.Organisations){<option value="@o.Id">@o.Name</option>}</select></div>}<p class="form-note">The payment provider shows the price, currency, tax and billing interval before you commit. Use its secure portal for invoices and cancellation.</p><button class="btn" disabled="@(!Model.BillingReady)">Continue to secure checkout →</button></form><div class="divider"></div><a class="text-link" href="/support">A billing question? →</a></section></div>
