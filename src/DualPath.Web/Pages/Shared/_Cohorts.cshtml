@model DualPath.Web.Pages.IndexModel
@if(Model.SelectedCohort is {} cohort){
<div class="stat-grid"><div class="stat"><div class="label">Enrolled learners</div><b>@cohort.Enrolments.Count</b><small>Actual enrolment records</small></div><div class="stat"><div class="label">Assigned instructor</div><strong>@cohort.Instructor.DisplayName</strong></div><div class="stat"><div class="label">Institution</div><strong>@cohort.Organisation.Name</strong></div></div><div class="grid2"><section class="card"><h3>Cohort announcements</h3>@if(Model.Announcements.Count==0){<p>No announcements yet.</p>}@foreach(var a in Model.Announcements){<article class="status-row"><div class="mini-label">@a.CreatedAt.ToString("dd MMM yyyy")</div><h4>@a.Title</h4><p class="read-work">@a.Body</p></article>}@if(Model.ManagedCohortIds.Contains(cohort.Id)){<details><summary>Publish an announcement</summary><form method="post" style="margin-top:20px"><input type="hidden" name="Command" value="announcement"><input type="hidden" name="Input.Id" value="@cohort.Id"><div class="field"><label asp-for="Input.Title">Title</label><input asp-for="Input.Title" maxlength="200" required></div><div class="field"><label asp-for="Input.Body">Message</label><textarea asp-for="Input.Body" maxlength="6000" required></textarea></div><button class="btn">Publish to this cohort →</button></form></details>}</section><section class="card"><h3>People on this path</h3>@if(Model.ManagedCohortIds.Contains(cohort.Id)){@foreach(var e in cohort.Enrolments){<div class="cohort-member"><strong>@e.User.DisplayName</strong><div class="tiny muted">@e.User.Email</div></div>}<div class="actions" style="margin-top:20px"><a class="btn outline sm" href="/reviews">Review submissions</a><a class="text-link" href="/members">Manage invitations →</a></div>}else{<p>Your instructor: @cohort.Instructor.DisplayName</p><p>Other students’ private work and account details are not visible here.</p><a class="btn" href="/work">Work on an assignment →</a>}</section></div>
@if(cohort.InstructorUserId==Model.Actor!.Id){<section class="card" style="margin-top:24px"><h3>Reflections shared with you</h3><p class="muted">Learners explicitly chose to share these reflections with this cohort’s assigned instructor.</p>@foreach(var r in Model.Reflections){<article class="status-row"><small>@r.CreatedAt.ToString("dd MMM yyyy")</small><p class="read-work">@r.Body</p></article>}@if(Model.Reflections.Count==0){<p>No shared reflections yet.</p>}</section>}
}else{
<div class="grid3">@foreach(var c in Model.Cohorts){<article class="card"><span class="badge">@c.Organisation.Name</span><h3 style="margin-top:20px">@c.Name</h3><p>@c.Instructor.DisplayName · @c.Enrolments.Count learners</p><a class="btn outline full sm" href="/cohort/@c.Id">Open cohort →</a></article>}</div>@if(Model.Cohorts.Count==0){<div class="empty-state"><h3>A shared path starts here.</h3><p>Create a cohort after adding an instructor, or accept your institution’s invitation.</p></div>}
@if(Model.Organisations.Count>0){<details class="card" style="margin-top:24px"><summary><strong>Create a new cohort</strong></summary><form method="post" style="margin-top:22px"><input type="hidden" name="Command" value="cohort"><div class="form-grid"><div class="field"><label asp-for="Input.Name">Cohort name</label><input asp-for="Input.Name" maxlength="160" required></div><div class="field"><label asp-for="Input.OrganisationId">Institution</label><select asp-for="Input.OrganisationId">@foreach(var o in Model.Organisations){<option value="@o.Id">@o.Name</option>}</select></div><div class="field"><label asp-for="Input.CourseId">Starting course</label><select asp-for="Input.CourseId">@foreach(var c in Model.Courses.Where(c=>c.Published)){<option value="@c.Id">@c.Title</option>}</select></div><div class="field"><label asp-for="Input.Instructor">Instructor</label><select asp-for="Input.Instructor" required>@foreach(var m in Model.Members.Where(m=>m.Role==Roles.Instructor&&m.Active)){<option value="@m.UserId">@m.User.DisplayName</option>}</select><span class="hint">Invite an instructor first if this list is empty.</span></div></div><button class="btn">Create cohort →</button></form></details>}
}
