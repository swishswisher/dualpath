@model DualPath.Web.Pages.IndexModel
<div class="grid2"><form class="card" method="post"><input type="hidden" name="Command" value="support"><h3>Tell us what would help.</h3><div class="field"><label asp-for="Input.Topic">Topic</label><select asp-for="Input.Topic"><option>Learning</option><option>Account</option><option>Billing</option><option>Privacy or deletion</option></select></div><div class="field"><label asp-for="Input.Title">Subject</label><input asp-for="Input.Title" maxlength="200" required></div><div class="field"><label asp-for="Input.Body">Your question</label><textarea asp-for="Input.Body" minlength="5" maxlength="10000" required></textarea></div><p class="form-note">Include the relevant page or module. Never send a password or payment card details.</p><button class="btn">Save your support request →</button></form><section><h3>@(Model.Actor!.PlatformAdmin?"Support queue":"Your requests")</h3>@if(Model.Requests.Count==0){<div class="empty-state"><p>Your saved support requests and staff responses will appear here.</p></div>}@foreach(var r in Model.Requests){<article class="card" style="margin-top:16px"><div class="between"><h4>@r.Subject</h4><span class="badge">@r.Status</span></div><p class="read-work">@r.Body</p>@if(r.Response!=""){<div class="callout"><strong>Staff response</strong><p>@r.Response</p></div>}@if(Model.Actor.PlatformAdmin){<details><summary>Respond to @r.Name</summary><form method="post" style="margin-top:18px"><input type="hidden" name="Command" value="support-review"><input type="hidden" name="Input.Id" value="@r.Id"><div class="field"><label for="response-@r.Id">Response</label><textarea name="Input.Body" id="response-@r.Id" required></textarea></div><select name="Input.Decision" aria-label="Request status"><option>Replied</option><option>Closed</option></select><button class="btn outline sm">Save & queue response</button></form></details>}</article>}</section></div>
