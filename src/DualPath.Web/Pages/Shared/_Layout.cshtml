@{
 var actor=ViewData["Actor"] as AppUser;var isPublic=ViewData["Public"] as bool? ?? true;var role=ViewData["Role"]?.ToString()??"Student";var section=ViewData["Section"]?.ToString()??"home";
 var navigation=role=="PlatformAdmin"?new[]{("admin","Overview"),("courses","Learning content"),("cohorts","Cohorts"),("members","People & access"),("content","Public website"),("audit","Activity & audit"),("support","Support requests")}:
 role==Roles.InstitutionAdmin?new[]{("organisation","Overview"),("cohorts","Cohorts"),("members","People & access"),("reports","Learning reports"),("orgbilling","Plan & seats")}:
 role==Roles.Instructor?new[]{("instructor","Overview"),("courses","Courses & lessons"),("cohorts","My cohorts"),("reviews","Review queue"),("reports","Learning reports")}:
 new[]{("dashboard","Overview"),("learning","My learning path"),("work","My work"),("reflections","Reflections"),("practice","Practice studio"),("feedback","Feedback"),("progress","My progress")};
}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0f172a"><meta name="description" content="Practical internship preparation: useful skills, meaningful feedback, and a clearer next step."><title>@ViewData["Title"] — DualPath</title><link rel="icon" href="/mark.svg"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"><link rel="stylesheet" href="~/css/product.css" asp-append-version="true"><script src="~/js/site.js" asp-append-version="true" defer></script></head>
<body><a href="#main" class="skip">Skip to content</a>
@if(isPublic){
<div class="wrap"><header class="public-header"><a class="logo" href="/"><img src="/mark.svg" alt="">DualPath</a><nav class="public-nav" aria-label="Main navigation"><a href="/programmes">Programmes</a><a href="/schools">For institutions</a><a href="/resources">Resources</a><a href="/pricing">Pricing</a><a href="/about">Our approach</a></nav><div class="header-actions">@if(actor==null){<a href="/signin">Sign in</a><a class="btn" href="/signup">Find your path ↗</a>}else{<a class="btn" href="/dashboard">Your workspace ↗</a>}</div><button class="mobile-menu" type="button" aria-label="Open navigation" aria-expanded="false" data-menu="public">☰</button></header></div><main id="main" class="public-main">@RenderBody()</main><footer class="footer"><div class="wrap"><div class="footer-top"><div><a class="logo" href="/"><img src="/mark.svg" alt="">DualPath</a><p>Build the skills. Make your mark.<br>A more intentional path to your first opportunity.</p></div><div><h4>Your next step</h4><a href="/programmes">Programmes</a><a href="/schools">For institutions</a><a href="/pricing">Plans & pricing</a></div><div><h4>A little guidance</h4><a href="/resources">Resource library</a><a href="/about">Our approach</a><a href="/contact">Get in touch</a></div><div><h4>Your workspace</h4><a href="/dashboard">Student portal</a><a href="/instructor">Instructor workspace</a><a href="/support">Help & support</a></div></div><div class="footer-bottom"><span>© @DateTime.UtcNow.Year DualPath</span><span><a href="/privacy" style="display:inline">Privacy</a> / <a href="/terms" style="display:inline">Terms</a></span></div></div></footer>
}else{
<div class="app-shell"><aside class="sidebar" id="sidebar"><button type="button" class="sidebar-close" data-menu="workspace" aria-label="Close workspace navigation">×</button><a class="logo" href="/"><img src="/mark.svg" alt="">DualPath</a><div class="workspace-label">@(role=="Student"?"Your learning space":role=="PlatformAdmin"?"Platform workspace":role=="InstitutionAdmin"?"Institution workspace":"Instructor workspace")</div><nav class="side-nav" aria-label="Workspace navigation">@foreach(var (path,label) in navigation){<a href="/@path" class="@(section==path?"active":"")"><span aria-hidden="true">@(section==path?"●":"○")</span> @label</a>}</nav><div class="sidebar-bottom"><nav class="side-nav" aria-label="Account navigation"><a href="/dashboard">My learning dashboard</a><a href="/notifications">Notifications</a><a href="/support">Help & support</a><a href="/account">Account settings</a></nav><div class="divider" style="margin:14px 0"></div><div class="profile"><span class="avatar sky">@(actor?.DisplayName.FirstOrDefault().ToString()??"D")</span><div><strong>@actor?.DisplayName</strong><small>@role</small></div></div><form method="post" asp-page="/Index" asp-route-section="account" style="margin-top:14px"><input type="hidden" name="Command" value="logout"><button class="text-link" type="submit">Sign out</button></form></div></aside><button class="sidebar-backdrop" data-menu="workspace" aria-label="Close workspace navigation"></button><div class="app-content"><header class="app-header"><div class="flex"><button class="icon-btn app-mobile-menu" data-menu="workspace" aria-label="Open workspace navigation" aria-expanded="false">☰</button><div class="crumb">Your workspace / <b>@ViewData["Title"]</b></div></div><div class="header-tools"><a class="icon-btn" href="/notifications" aria-label="Notifications"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></a><a href="/account" aria-label="Account settings"><span class="avatar sky">@(actor?.DisplayName.FirstOrDefault().ToString()??"D")</span></a></div></header><main class="app-main" id="main">@if(ViewData["Demo"] as bool?==true){<div class="sample-banner">Development workspace · demonstration accounts and records. Your changes persist in this development database.</div>}@RenderBody()</main></div></div>
}
</body></html>
