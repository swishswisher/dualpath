@model DualPath.Web.Pages.IndexModel
<div class="tabs"><a class="active" href="/account">Profile & preferences</a><a href="/billing">Plan & billing</a></div><div class="grid2"><form method="post" class="card"><input type="hidden" name="Command" value="account"><h3>Your details</h3><div class="field"><label for="account-name">Display name</label><input id="account-name" name="Input.Name" value="@Model.Actor!.DisplayName" maxlength="120" required></div><div class="field"><label>Email address</label><p>@Model.Actor.Email</p><span class="hint">To change your verified email, open an account-support request.</span></div><div class="field"><label for="account-timezone">Time zone</label><select id="account-timezone" name="Input.TimeZone">@foreach(var t in TimeZoneInfo.GetSystemTimeZones()){<option value="@t.Id" selected="@(t.Id==Model.Actor.TimeZone)">@t.DisplayName</option>}</select></div><div class="checklist"><label><input type="checkbox" name="Input.Reminders" value="true" checked="@Model.Actor.Reminders">Learning reminders</label><label><input type="checkbox" name="Input.Marketing" value="true" checked="@Model.Actor.Marketing">Optional programme news</label><label><input type="checkbox" name="Input.AiConsent" value="true" checked="@Model.Actor.AiConsent">Enable optional AI practice</label></div><p class="form-note" style="margin-top:16px">AI practice sends only your selected assessment question and practice answer to the configured AI processor. It excludes your account profile and reflections. You can revoke this choice at any time.</p><button class="btn">Save preferences</button></form><div class="stack"><form method="post" class="card"><input type="hidden" name="Command" value="password"><h3>Keep your sign-in private.</h3><div class="field"><label asp-for="Input.CurrentPassword">Current password</label><input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" required></div><div class="field"><label asp-for="Input.Password">New password</label><input asp-for="Input.Password" type="password" minlength="12" autocomplete="new-password" required></div><button class="btn outline">Update password</button></form><section class="card"><h3>Your data, in your hands.</h3><form method="post"><input type="hidden" name="Command" value="export"><button class="btn outline sm">Download your learning records</button></form><p class="form-note" style="margin-top:16px">For corrections or deletion, open a privacy support request. Any retention requirements will be reviewed before records are removed.</p><a class="text-link" href="/support">Privacy support →</a></section></div></div>
