@model DualPath.Web.Pages.IndexModel
@if(Model.Organisations.Count==0){<section class="card content-wrap"><h2 style="font-size:30px">Give your students a clearer start.</h2><p>Create an institution workspace, invite your teaching staff, and organise a practical programme.</p><form method="post"><input type="hidden" name="Command" value="institution"><div class="field"><label asp-for="Input.Name">Institution name</label><input asp-for="Input.Name" maxlength="160" required></div><div class="field"><label asp-for="Input.Email">Billing/contact email</label><input asp-for="Input.Email" type="email" required></div><button class="btn">Create your institution →</button></form></section>}
else{
<div class="stat-grid"><div class="stat"><div class="label">Your institutions</div><b>@Model.Organisations.Count</b></div><div class="stat"><div class="label">Visible active members</div><b>@Model.Members.Count(m=>m.Active)</b><small>Current page of authorised memberships</small></div><div class="stat"><div class="label">Open invitations</div><b>@Model.Invitations.Count</b></div></div><section class="card"><div class="subhead"><h3>People & permissions</h3><a class="text-link" href="/cohorts">Manage cohorts →</a></div><form method="get" class="filter-row"><input type="search" name="Search" value="@Model.Search" aria-label="Search people" placeholder="Find a person"><button class="btn outline sm">Search</button></form><div class="table-wrap"><table class="table"><thead><tr><th>Person</th><th>Role</th><th>Status</th><th>Manage</th></tr></thead><tbody>@foreach(var m in Model.Members){<tr><td><strong>@m.User.DisplayName</strong><div class="tiny muted">@m.User.Email</div></td><td>@m.Role</td><td><span class="badge">@(m.Active?"Active":"Inactive")</span></td><td><details><summary>Edit access</summary><form method="post" style="min-width:170px;margin-top:12px"><input type="hidden" name="Command" value="membership"><input type="hidden" name="Input.Id" value="@m.Id"><label class="help-label" for="role-@m.Id">Role</label><select name="Input.Role" id="role-@m.Id">@foreach(var r in new[]{Roles.Student,Roles.Instructor,Roles.InstitutionAdmin}){<option selected="@(r==m.Role)">@r</option>}</select><label class="label-check" style="margin:12px 0"><input type="checkbox" name="Input.Active" value="true" checked="@m.Active">Active membership</label><input type="hidden" name="Input.Active" value="false"><button class="btn outline sm">Save access</button></form></details></td></tr>}</tbody></table></div><div class="page-pagination">@if(Model.PageNumber>1){<a class="text-link" href="?PageNumber=@(Model.PageNumber-1)&Search=@Uri.EscapeDataString(Model.Search)">← Previous</a>}@if(Model.Members.Count==50){<a class="text-link" href="?PageNumber=@(Model.PageNumber+1)&Search=@Uri.EscapeDataString(Model.Search)">Next →</a>}</div></section><div class="grid2" style="margin-top:24px"><section class="card"><h3>Invite a learner or colleague.</h3><form method="post"><input type="hidden" name="Command" value="invite"><div class="field"><label asp-for="Input.Email">Recipient email</label><input asp-for="Input.Email" type="email" required></div><div class="field"><label asp-for="Input.OrganisationId">Institution</label><select asp-for="Input.OrganisationId">@foreach(var o in Model.Organisations){<option value="@o.Id">@o.Name</option>}</select></div><div class="field"><label asp-for="Input.Role">Role</label><select asp-for="Input.Role"><option value="Student">Student</option><option value="Instructor">Instructor</option><option value="InstitutionAdmin">Institution administrator</option></select></div><div class="field"><label asp-for="Input.CohortId">Student cohort (optional)</label><select asp-for="Input.CohortId"><option value="">No cohort / staff invitation</option>@foreach(var c in Model.Cohorts){<option value="@c.Id">@c.Name</option>}</select></div><button class="btn">Save & queue invitation →</button><p class="form-note" style="margin-top:12px">Invitations expire after seven days and require the recipient’s verified email.</p></form></section><section class="card"><h3>Available student seats</h3>@foreach(var o in Model.Organisations){<div class="line-item"><strong>@o.Name</strong><span>Seat limit: @o.SeatLimit</span></div>@if(Model.Actor!.PlatformAdmin){<form method="post" class="filter-row"><input type="hidden" name="Command" value="seat-limit"><input type="hidden" name="Input.Id" value="@o.Id"><label for="seats-@o.Id">New capacity</label><input id="seats-@o.Id" name="Input.SeatLimit" type="number" value="@o.SeatLimit" min="0" max="100000" required><button class="btn outline sm">Save capacity</button></form>}}<p class="form-note">Seat capacity is enforced when an invitation is accepted or a student membership is activated.</p><a class="text-link" href="/orgbilling">Plan & seat support →</a><div class="divider"></div><h4>Pending invitations</h4>@if(Model.Invitations.Count==0){<p>No pending invitations.</p>}@foreach(var i in Model.Invitations){<div class="line-item"><span>@i.Email</span><span class="tiny muted">@i.Role · @i.ExpiresAt.ToString("dd MMM")</span><form method="post"><input type="hidden" name="Command" value="revoke-invite"><input type="hidden" name="Input.Id" value="@i.Id"><button class="plain-action">Revoke invitation</button></form></div>}</section></div>
}
